#!/bin/bash
set -euo pipefail

VERSION="0.4.2"
ROOT="${CLAUDE_CLONER_HOME:-$HOME/.claude-cloner}"
APPS_DIR="${CLAUDE_CLONER_APPS:-$HOME/Applications}"
SOURCE_APP="${CLAUDE_CLONER_SOURCE:-/Applications/Claude.app}"
MAIN_CONFIG="${CLAUDE_CLONER_MAIN_CONFIG:-$HOME/.claude}"
MAIN_SUPPORT="${CLAUDE_CLONER_MAIN_SUPPORT:-$HOME/Library/Application Support/Claude}"
RUNTIME="$ROOT/bin/cloner"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

die() {
  echo "cloner: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
cloner $VERSION

Run several Claude desktop instances side by side, each with its own login.
Profiles are numbered from 2 (your regular Claude is the first one).

Usage:
  cloner add [number]                   create a profile: the next free number, or the one you give
  cloner open <number>                  open a profile (updates it first if needed)
  cloner list                           show profiles, versions and state
  cloner update [number] [--force]      refresh profile copies from the installed Claude
  cloner remove <number> [--keep-data]  delete a profile, including its login and data
  cloner cli <number> [args...]         run the Claude Code CLI with the profile's own login
  cloner copy <from> <to> [options]    copy skills, agents, memory and more between Claude instances (1 is your regular Claude)
  cloner version

Good to know:
  - Open profiles from their launcher, not from the Dock icon of a running copy.
  - Signing in opens your browser, which may approve the account it is already signed in with.
  - copy needs the destination profile closed, and keeps a backup of what it replaces.

Launcher apps are created in $APPS_DIR.
Profile data lives in $ROOT.
EOF
}

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "this tool only works on macOS"
}

require_source() {
  [ -d "$SOURCE_APP" ] || die "Claude desktop not found at $SOURCE_APP"
}

valid_number() {
  case "$1" in
    "" | *[!0-9]* | 0*) return 1 ;;
  esac
  [ "${#1}" -le 3 ] && [ "$1" -ge 2 ]
}

profile_dir() {
  echo "$ROOT/profiles/$1"
}

profile_exists() {
  [ -f "$(profile_dir "$1")/badge" ]
}

require_profile() {
  valid_number "$1" || die "invalid profile number: '$1' (profiles start at 2)"
  profile_exists "$1" || die "no profile $1 (see: cloner list)"
}

launcher_path() {
  echo "$APPS_DIR/Claude $1.app"
}

profile_numbers() {
  local file
  [ -d "$ROOT/profiles" ] || return 0
  for file in "$ROOT"/profiles/*/badge; do
    [ -f "$file" ] || continue
    basename "$(dirname "$file")"
  done | sort -n
}

next_number() {
  local n=2
  while profile_exists "$n" || [ -d "$(launcher_path "$n")" ]; do
    n=$((n + 1))
  done
  echo "$n"
}

app_version() {
  local plist="$1/Contents/Info.plist"
  [ -f "$plist" ] || return 0
  /usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$plist" 2>/dev/null || true
}

is_running() {
  pgrep -f "$1/Claude.app/Contents/MacOS/" >/dev/null 2>&1
}

is_misplaced() {
  local binary="$1/Claude.app/Contents/MacOS/Claude" pid cmd
  for pid in $(pgrep -f "$binary" 2>/dev/null); do
    cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$cmd" in
      *"--type="*) continue ;;
      *"$binary"*) ;;
      *) continue ;;
    esac
    case "$cmd" in
      *"--user-data-dir=$1/data"*) ;;
      *) return 0 ;;
    esac
  done
  return 1
}

emit_jxa() {
  cat <<'JXA'
ObjC.import('AppKit');
ObjC.import('CoreGraphics');

var PALETTE = [
  [0.12, 0.45, 0.95],
  [0.13, 0.62, 0.31],
  [0.55, 0.31, 0.85],
  [0.90, 0.25, 0.55],
  [0.04, 0.63, 0.68],
  [0.85, 0.18, 0.18],
  [0.88, 0.60, 0.04],
  [0.26, 0.31, 0.45]
];

function badgeColor(text) {
  var n = parseInt(text, 10);
  if (isNaN(n)) {
    n = 0;
    for (var i = 0; i < text.length; i++) {
      n += text.charCodeAt(i);
    }
  }
  var index = (((n - 2) % PALETTE.length) + PALETTE.length) % PALETTE.length;
  return PALETTE[index];
}

function render(source, output, text) {
  var src = $.NSImage.alloc.initWithContentsOfFile(source);
  var size = 1024;
  var rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(null, size, size, 8, 4, true, false, $.NSDeviceRGBColorSpace, 0, 0);
  var ctx = $.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep);
  $.NSGraphicsContext.setCurrentContext(ctx);
  src.drawInRectFromRectOperationFraction($.NSMakeRect(0, 0, size, size), $.NSZeroRect, $.NSCompositingOperationSourceOver, 1.0);
  var d = size * 0.46;
  var circle = $.NSMakeRect(size - d - size * 0.02, size * 0.02, d, d);
  var cg = ctx.CGContext;
  var color = badgeColor(text);
  $.CGContextSetRGBFillColor(cg, color[0], color[1], color[2], 1);
  $.CGContextFillEllipseInRect(cg, circle);
  $.CGContextSetRGBStrokeColor(cg, 1, 1, 1, 1);
  $.CGContextSetLineWidth(cg, d * 0.06);
  $.CGContextStrokeEllipseInRect(cg, $.NSInsetRect(circle, d * 0.03, d * 0.03));
  var label = text.substring(0, 2);
  var fontSize = label.length === 1 ? d * 0.72 : d * 0.5;
  var font = $.NSFont.systemFontOfSizeWeight(fontSize, $.NSFontWeightHeavy);
  var attrs = $.NSDictionary.dictionaryWithObjectsForKeys($([font, $.NSColor.whiteColor]), $([$.NSFontAttributeName, $.NSForegroundColorAttributeName]));
  var str = $(label);
  var sz = str.sizeWithAttributes(attrs);
  str.drawAtPointWithAttributes($.NSMakePoint(circle.origin.x + d / 2 - sz.width / 2, circle.origin.y + d / 2 - sz.height / 2), attrs);
  ctx.flushGraphics;
  var png = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $({}));
  png.writeToFileAtomically(output, true);
}

function setIcon(icns, target) {
  var image = $.NSImage.alloc.initWithContentsOfFile(icns);
  return $.NSWorkspace.sharedWorkspace.setIconForFileOptions(image, target, 0);
}

function run(argv) {
  if (argv[0] === 'render') {
    render(argv[1], argv[2], argv[3]);
    return 'ok';
  }
  if (argv[0] === 'seticon') {
    return setIcon(argv[1], argv[2]) ? 'ok' : 'failed';
  }
  return 'usage';
}
JXA
}

run_jxa() {
  local script out rc=0
  script="$(mktemp "${TMPDIR:-/tmp}/cloner.XXXXXX")"
  emit_jxa >"$script"
  out="$(osascript -l JavaScript "$script" "$@" 2>&1)" || rc=$?
  rm -f "$script"
  [ "$rc" -eq 0 ] && [ "$out" = "ok" ] || die "icon step failed: $out"
}

icon_source() {
  local name
  name="$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" "$SOURCE_APP/Contents/Info.plist")"
  case "$name" in
    *.icns) ;;
    *) name="$name.icns" ;;
  esac
  echo "$SOURCE_APP/Contents/Resources/$name"
}

build_icon() {
  local badge="$1" output="$2" work spec
  work="$(mktemp -d "${TMPDIR:-/tmp}/cloner.XXXXXX")"
  mkdir -p "$work/badge.iconset"
  run_jxa render "$(icon_source)" "$work/master.png" "$badge"
  for spec in "16 icon_16x16" "32 icon_16x16@2x" "32 icon_32x32" "64 icon_32x32@2x" \
    "128 icon_128x128" "256 icon_128x128@2x" "256 icon_256x256" "512 icon_256x256@2x" \
    "512 icon_512x512" "1024 icon_512x512@2x"; do
    set -- $spec
    sips -z "$1" "$1" "$work/master.png" --out "$work/badge.iconset/$2.png" >/dev/null
  done
  iconutil -c icns "$work/badge.iconset" -o "$output"
  rm -rf "$work"
}

copy_app() {
  rm -rf "$2"
  mkdir -p "$(dirname "$2")"
  if ! cp -cR "$1" "$2" 2>/dev/null; then
    rm -rf "$2"
    ditto "$1" "$2"
  fi
}

install_runtime() {
  local self="${BASH_SOURCE[0]}" self_abs
  mkdir -p "$ROOT/bin"
  self_abs="$(cd "$(dirname "$self")" && pwd)/$(basename "$self")"
  if [ "$self_abs" != "$RUNTIME" ]; then
    cp "$self" "$RUNTIME"
  fi
  chmod +x "$RUNTIME"
}

rebuild_profile() {
  local dir
  dir="$(profile_dir "$1")"
  copy_app "$SOURCE_APP" "$dir/Claude.app"
  build_icon "$1" "$dir/icon.icns"
  run_jxa seticon "$dir/icon.icns" "$dir/Claude.app"
}

ensure_icon() {
  local dir app
  dir="$(profile_dir "$1")"
  app="$dir/Claude.app"
  [ -d "$app" ] && [ -f "$dir/icon.icns" ] || return 0
  [ -e "$app/"$'Icon\r' ] || run_jxa seticon "$dir/icon.icns" "$app"
}

should_rebuild() {
  local app src cur newest
  app="$(profile_dir "$1")/Claude.app"
  [ -d "$app" ] || return 0
  src="$(app_version "$SOURCE_APP")"
  cur="$(app_version "$app")"
  if [ -z "$src" ] || [ "$src" = "$cur" ]; then
    return 1
  fi
  newest="$(printf '%s\n%s\n' "$src" "$cur" | sort -V | tail -1)"
  [ "$newest" = "$src" ]
}

create_launcher() {
  local number="$1" dir app
  dir="$(profile_dir "$number")"
  app="$(launcher_path "$number")"
  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$dir/icon.icns" "$app/Contents/Resources/icon.icns"
  cat >"$app/Contents/MacOS/launcher" <<EOF
#!/bin/bash
exec "$RUNTIME" open "$number"
EOF
  chmod +x "$app/Contents/MacOS/launcher"
  cat >"$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>launcher</string>
  <key>CFBundleIdentifier</key><string>io.github.claude-cloner.p$number</string>
  <key>CFBundleName</key><string>Claude $number</string>
  <key>CFBundleDisplayName</key><string>Claude $number</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
EOF
  codesign --force --sign - "$app" >/dev/null 2>&1 || true
  "$LSREGISTER" -f "$app" >/dev/null 2>&1 || true
}

cmd_add() {
  local number=""
  [ $# -le 1 ] || die "usage: cloner add [number]"
  if [ $# -eq 1 ]; then
    number="$1"
    valid_number "$number" || die "invalid profile number: '$number' (profiles start at 2)"
    profile_exists "$number" && die "profile $number already exists"
  fi
  require_source
  if [ -z "$number" ]; then
    number="$(next_number)"
  fi
  mkdir -p "$(profile_dir "$number")/data" "$(profile_dir "$number")/cli"
  printf '%s\n' "$number" >"$(profile_dir "$number")/badge"
  install_runtime
  echo "Copying Claude (this can take a moment)..."
  rebuild_profile "$number"
  create_launcher "$number"
  echo "Profile $number is ready."
  echo
  echo "Next steps:"
  echo "  1. Open it from Claude $number in Spotlight or Launchpad, or run: cloner open $number"
  echo "     Do not start it from the Dock icon of a running copy: it would use your regular Claude data."
  echo "  2. Sign in with the account you want for this profile."
  echo "     Your browser may approve the account it is already signed in with: use a private window or switch account."
  echo "  3. Optional, with the profile closed: cloner copy 1 $number"
}

cmd_open() {
  local dir
  [ $# -eq 1 ] || die "usage: cloner open <number>"
  require_profile "$1"
  require_source
  dir="$(profile_dir "$1")"
  if is_misplaced "$dir"; then
    die "profile $1 is running without its own data folder (it probably restarted itself after an update). Quit it, then open it again."
  fi
  ensure_icon "$1"
  if ! is_running "$dir" && should_rebuild "$1"; then
    rebuild_profile "$1"
  fi
  exec /usr/bin/open -n "$dir/Claude.app" --env CLAUDE_CONFIG_DIR="$dir/cli" --args --user-data-dir="$dir/data"
}

update_one() {
  local number="$1" force="$2" dir
  dir="$(profile_dir "$number")"
  ensure_icon "$number"
  if is_running "$dir"; then
    echo "$number: running, close it first"
    return 0
  fi
  if [ "$force" = "yes" ] || should_rebuild "$number"; then
    rebuild_profile "$number"
    echo "$number: updated to $(app_version "$dir/Claude.app")"
  else
    echo "$number: up to date ($(app_version "$dir/Claude.app"))"
  fi
}

cmd_update() {
  local number="" force="no" arg
  for arg in "$@"; do
    case "$arg" in
      --force) force="yes" ;;
      -*) die "unknown option: $arg" ;;
      *) number="$arg" ;;
    esac
  done
  require_source
  install_runtime
  if [ -n "$number" ]; then
    require_profile "$number"
    update_one "$number" "$force"
    return 0
  fi
  for number in $(profile_numbers); do
    update_one "$number" "$force"
  done
}

cmd_list() {
  local number dir state
  printf '%-9s %-12s %s\n' PROFILE VERSION STATE
  for number in $(profile_numbers); do
    dir="$(profile_dir "$number")"
    state="closed"
    if is_misplaced "$dir"; then
      state="running on wrong data"
    elif is_running "$dir"; then
      state="running"
    fi
    printf '%-9s %-12s %s\n' "$number" "$(app_version "$dir/Claude.app")" "$state"
  done
}

cmd_remove() {
  local number="" keep="no" arg dir
  for arg in "$@"; do
    case "$arg" in
      --keep-data) keep="yes" ;;
      -*) die "unknown option: $arg" ;;
      *) number="$arg" ;;
    esac
  done
  [ -n "$number" ] || die "usage: cloner remove <number> [--keep-data]"
  valid_number "$number" || die "invalid profile number: '$number' (profiles start at 2)"
  dir="$(profile_dir "$number")"
  [ -d "$dir" ] || die "no profile $number (see: cloner list)"
  is_running "$dir" && die "profile $number is running, close it first"
  rm -rf "$(launcher_path "$number")"
  if [ "$keep" = "yes" ]; then
    rm -rf "$dir/Claude.app" "$dir/icon.icns" "$dir/badge"
    echo "Profile $number removed. Its login and data are kept in $dir, and come back if you add $number again."
  else
    rm -rf "$dir"
    echo "Profile $number deleted, including its login and data."
  fi
}

cmd_cli() {
  [ $# -ge 1 ] || die "usage: cloner cli <number> [args...]"
  local number="$1"
  shift
  require_profile "$number"
  command -v claude >/dev/null 2>&1 || die "the 'claude' command was not found in PATH"
  CLAUDE_CONFIG_DIR="$(profile_dir "$number")/cli" exec claude "$@"
}

config_dir() {
  if [ "$1" = "1" ]; then
    echo "$MAIN_CONFIG"
  else
    echo "$(profile_dir "$1")/cli"
  fi
}

desktop_config_file() {
  if [ "$1" = "1" ]; then
    echo "$MAIN_SUPPORT/claude_desktop_config.json"
  else
    echo "$(profile_dir "$1")/data/claude_desktop_config.json"
  fi
}

require_copy_source() {
  if [ "$1" = "1" ]; then
    return 0
  fi
  require_profile "$1"
}

BACKUP_DIR=""
TARGET=""
DRY_RUN="no"
LINK="no"

backup_existing() {
  local path="$1" label="$2"
  [ -e "$path" ] || [ -L "$path" ] || return 0
  if [ -z "$BACKUP_DIR" ]; then
    BACKUP_DIR="$(config_dir "$TARGET")/.cloner-backup/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
  fi
  cp -cRP "$path" "$BACKUP_DIR/$label" 2>/dev/null || cp -RP "$path" "$BACKUP_DIR/$label"
}

count_files() {
  if [ -d "$1" ]; then
    find "$1" -type f | wc -l | tr -d ' '
  else
    echo 1
  fi
}

transfer() {
  local label="$1" src="$2" dst="$3"
  if [ ! -e "$src" ]; then
    echo "  $label: nothing to copy"
    return 0
  fi
  if [ "$DRY_RUN" = "yes" ]; then
    echo "  $label: would copy $(count_files "$src") file(s)"
    return 0
  fi
  backup_existing "$dst" "$label"
  mkdir -p "$(dirname "$dst")"
  if [ -d "$src" ] && [ "$LINK" = "yes" ]; then
    rm -rf "$dst"
    ln -s "$src" "$dst"
    echo "  $label: linked"
  elif [ -d "$src" ]; then
    mkdir -p "$dst"
    ditto "$src" "$dst"
    echo "  $label: copied $(count_files "$src") file(s)"
  else
    cp "$src" "$dst"
    echo "  $label: copied"
  fi
}

transfer_memory() {
  local src_cfg="$1" dst_cfg="$2" dir slug count=0
  for dir in "$src_cfg"/projects/*/memory; do
    [ -d "$dir" ] || continue
    slug="$(basename "$(dirname "$dir")")"
    count=$((count + 1))
    if [ "$DRY_RUN" != "yes" ]; then
      backup_existing "$dst_cfg/projects/$slug/memory" "memory-$slug"
      mkdir -p "$dst_cfg/projects/$slug/memory"
      ditto "$dir" "$dst_cfg/projects/$slug/memory"
    fi
  done
  if [ "$DRY_RUN" = "yes" ]; then
    echo "  memory: would copy $count project(s)"
  else
    echo "  memory: copied $count project(s)"
  fi
}

cmd_copy() {
  local from="" to="" only="skills,agents,commands,instructions" item src_cfg dst_cfg
  local items
  DRY_RUN="no"
  LINK="no"
  BACKUP_DIR=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --only)
        [ $# -ge 2 ] || die "--only needs a value"
        only="$2"
        shift 2
        ;;
      --link)
        LINK="yes"
        shift
        ;;
      --dry-run)
        DRY_RUN="yes"
        shift
        ;;
      -*) die "unknown option: $1" ;;
      *)
        if [ -z "$from" ]; then
          from="$1"
        elif [ -z "$to" ]; then
          to="$1"
        else
          die "unexpected argument: $1"
        fi
        shift
        ;;
    esac
  done
  [ -n "$from" ] && [ -n "$to" ] || die "usage: cloner copy <from> <to> [--only items] [--link] [--dry-run]"
  [ "$from" != "$to" ] || die "source and destination are the same"
  require_copy_source "$from"
  valid_number "$to" || die "the destination must be a profile number (2 or higher)"
  require_profile "$to"
  if [ "$DRY_RUN" != "yes" ] && is_running "$(profile_dir "$to")"; then
    die "profile $to is running, close it first"
  fi
  IFS=',' read -r -a items <<<"$only"
  for item in "${items[@]}"; do
    case "$item" in
      skills | agents | commands | hooks | instructions | settings | memory | mcp) ;;
      *) die "unknown item '$item' (choose from: skills, agents, commands, hooks, instructions, settings, memory, mcp)" ;;
    esac
  done
  TARGET="$to"
  src_cfg="$(config_dir "$from")"
  dst_cfg="$(config_dir "$to")"
  mkdir -p "$dst_cfg"
  if [ "$DRY_RUN" = "yes" ]; then
    echo "Dry run, nothing is written. From $from to $to:"
  else
    echo "Copying from $from to $to:"
  fi
  for item in "${items[@]}"; do
    case "$item" in
      skills) transfer skills "$src_cfg/skills" "$dst_cfg/skills" ;;
      agents) transfer agents "$src_cfg/agents" "$dst_cfg/agents" ;;
      commands) transfer commands "$src_cfg/commands" "$dst_cfg/commands" ;;
      hooks) transfer hooks "$src_cfg/hooks" "$dst_cfg/hooks" ;;
      instructions) transfer instructions "$src_cfg/CLAUDE.md" "$dst_cfg/CLAUDE.md" ;;
      settings) transfer settings "$src_cfg/settings.json" "$dst_cfg/settings.json" ;;
      memory) transfer_memory "$src_cfg" "$dst_cfg" ;;
      mcp)
        echo "  mcp: this file can contain API keys, it is copied as is"
        transfer mcp "$(desktop_config_file "$from")" "$(desktop_config_file "$to")"
        ;;
    esac
  done
  if [ "$DRY_RUN" != "yes" ]; then
    echo "Close and reopen profile $to to load the changes."
    for item in "${items[@]}"; do
      case "$item" in
        memory) echo "Note: memory can carry context from one account into the other." ;;
        skills | agents | commands | hooks)
          if [ "$LINK" = "yes" ]; then
            echo "Note: $item are linked to the source. Changes show up in both, and removing a profile never deletes the source."
          fi
          ;;
      esac
    done
  fi
  if [ -n "$BACKUP_DIR" ]; then
    echo "Replaced files were saved in $BACKUP_DIR"
  fi
}

main() {
  require_macos
  local command="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$command" in
    add) cmd_add "$@" ;;
    open) cmd_open "$@" ;;
    update) cmd_update "$@" ;;
    list | ls) cmd_list ;;
    remove | rm) cmd_remove "$@" ;;
    cli) cmd_cli "$@" ;;
    copy) cmd_copy "$@" ;;
    version | --version | -v) echo "cloner $VERSION" ;;
    help | --help | -h) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
